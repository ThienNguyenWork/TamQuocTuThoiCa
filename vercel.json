{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/chat/history",
      "destination": "/api/history"
    },
    {
      "source": "/api/chat/feedback",
      "destination": "/api/feedback"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/:match*"
    },
    {
      "source": "/((?!api|assets|favicon|.*\\..*).*)$",
      "destination": "/index.html"
    }
  ]
}
